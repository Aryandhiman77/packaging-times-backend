NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/packaging_times
CLIENT_ORIGIN=http://localhost:5173
PUBLIC_SITE_URL=http://localhost:5173
SPA_DIST_DIR=../client/dist

# Primary admin: synchronized into MongoDB every time the API starts.
# Changing either value updates the primary admin and invalidates old sessions.
ADMIN_EMAIL=admin@packagingtimes.com
ADMIN_PASSWORD=replace-with-a-strong-password-of-at-least-8-characters
JWT_SECRET=replace-with-at-least-32-random-characters

# SMTP account used to send admin and client notifications.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=info@packagingtimes.com
SMTP_PASS=replace-with-smtp-password
SMTP_FROM="Packaging Times <info@packagingtimes.com>"
